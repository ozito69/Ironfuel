{
  // Cloudflare Workers + static assets. Deploy with: npx wrangler deploy  (after a release build)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironfuel-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
