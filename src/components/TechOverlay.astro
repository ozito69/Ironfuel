---
// Decorative laboratory layer drawn as live SVG so it stays crisp at any size.
// Same 720 x 1454 box as the hero artwork, cropped with the same rule (slice), so the two stay aligned.
const ticks = Array.from({ length: 73 }, (_, i) => i * 20);
const reticles = [
  { x: 96, y: 372, r: 26 },
  { x: 118, y: 1086, r: 22 },
  { x: 628, y: 1290, r: 24, pulse: true },
];
---
<svg class="tech" viewBox="0 0 720 1454" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <!-- ruler -->
  <line class="tick" x1="14" y1="0" x2="14" y2="1454" />
  {ticks.map((y, i) => <line class="tick" x1="14" y1={y} x2={i % 5 === 0 ? 34 : 24} y2={y} />)}
  <!-- measurement arcs -->
  <circle class="arc arc--dash" cx="470" cy="610" r="250" />
  <circle class="arc" cx="470" cy="610" r="172" />
  <path class="arc" d="M720 210 A 360 360 0 0 0 408 0" />
  <!-- guide lines -->
  <path class="line-red" d="M96 372 H300 V470" />
  <path class="line-red" d="M118 1086 H230 V1000" />
  <line class="tick" x1="0" y1="790" x2="720" y2="790" stroke-dasharray="2 10" />
  <!-- reticles -->
  {reticles.map((p) => (
    <g>
      <circle class="arc" cx={p.x} cy={p.y} r={p.r * 1.7} />
      <circle class="node-ring" class:list={[p.pulse && 'pulse']} cx={p.x} cy={p.y} r={p.r * 0.6} />
      <circle class="node" cx={p.x} cy={p.y} r="4.5" />
      <line class="tick" x1={p.x - p.r * 2.4} y1={p.y} x2={p.x - p.r * 1.3} y2={p.y} />
      <line class="tick" x1={p.x + p.r * 1.3} y1={p.y} x2={p.x + p.r * 2.4} y2={p.y} />
    </g>
  ))}
</svg>
