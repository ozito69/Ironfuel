---
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '../styles/global.css';
import fontDisplay from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import fontBody from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand, IS_RELEASE, SITE_URL, links, analytics } from '../data/site';

interface Props { title?: string; description?: string; path?: string; jsonLd?: object[] }
const { title = brand.title, description = brand.description, path = '/', jsonLd = [] } = Astro.props;
const canonical = new URL(path, SITE_URL).toString();
const ogImage = new URL('/og-image.jpg', SITE_URL).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!IS_RELEASE && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#131416" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="IRONFUEL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="IRONFUEL: Train smarter. Build stronger. Muscle-fibre artwork on a graphite background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body id="top-of-page">
    <a class="skip-link" href="#main">Skip to content</a>
    {!IS_RELEASE && <aside class="preview-bar" aria-label="Preview build notice">PREVIEW BUILD: contains TODO placeholders and is not for public release.</aside>}
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    {analytics.cloudflareWebAnalyticsToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analytics.cloudflareWebAnalyticsToken })}></script>
    )}
    <script>
      // Carry UTM parameters from the landing URL to the Whop links only (not to Telegram).
      const utm = [...new URLSearchParams(location.search)].filter(([k]) => k.startsWith('utm_'));
      if (utm.length) {
        document.querySelectorAll<HTMLAnchorElement>('a[data-utm]').forEach((a) => {
          const u = new URL(a.href);
          utm.forEach(([k, v]) => u.searchParams.set(k, v));
          a.href = u.toString();
        });
      }
    </script>
  </body>
</html>
